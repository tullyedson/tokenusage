{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Usage",
  "version": "0.7.1",
  "identifier": "com.aiusagetray.desktop",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "AI Usage",
      "width": 980,
      "height": 780,
      "minWidth": 560,
      "minHeight": 460,
      "visible": false,
      "center": true,
      "backgroundColor": "#11191c",
      "dragDropEnabled": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "AI account usage in your system tray",
    "longDescription": "View remaining AI allowances, credits and budgets in one private desktop app.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"],
        "startMenuFolder": "AI Usage",
        "installerHooks": "installer/hooks.nsh"
      }
    }
  }
}
